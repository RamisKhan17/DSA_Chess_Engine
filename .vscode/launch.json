{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Chess Engine",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/chess.exe",
      "args": [
  "-t", "600000",
  "-i", "5000",
  "-d", "5",
  "-m", "-1",
  "-f", "4"
]
,
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "Compile Chess Engine"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/CS/Semester 3/Data Structures and Algorithms/Project/DSA_Chess_Engine",
      "program": "d:/CS/Semester 3/Data Structures and Algorithms/Project/DSA_Chess_Engine/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}