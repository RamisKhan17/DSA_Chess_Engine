{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-I\"D:/C++ Libraries/SFML-3.0.2/include\"",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-L\"D:/C++ Libraries/SFML-3.0.2/lib\"",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "Build Chess Engine (Full Project)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-I./include",
                "-I\"D:/C++ Libraries/SFML-3.0.2/include\"",
                "-L\"D:/C++ Libraries/SFML-3.0.2/lib\"",
                "src/Board.cpp",
                "src/GUI.cpp",
                "main.cpp",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-o",
                "ChessEngine.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build the complete chess engine with GUI"
        },
        {
            "type": "cppbuild",
            "label": "Build Console Test",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-I./include",
                "src/Board.cpp",
                "console_test.cpp",
                "-o",
                "ConsoleTest.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build console test (no SFML required)"
        },
        {
            "type": "cppbuild",
            "label": "Build Interactive Chess",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-I./include",
                "src/Board.cpp",
                "interactive_chess.cpp",
                "-o",
                "InteractiveChess.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build interactive console chess"
        }
    ],
    "version": "2.0.0"
}